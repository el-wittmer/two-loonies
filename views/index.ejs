<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Currency Converter</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Currency Converter</h1>
    <% if (locals.conversionRates) {%>
        <div class="money-amount">
            <form action="/submit" action="/" method="GET">
                <input type="text" name="amount" placeholder="Base Amount" autocomplete="off" required>
        </div>
        <div class="rate-selection">
            <div class="rate" label="base">
                <select name="base" id="base" required>
                    <%for (const key in conversionRates) {
                        if (conversionRates.hasOwnProperty(key)) {%>
                        <option value="<%=key%>"><%= key %></option>
                        <%}
                    }%>
                </select>
            </div>

            <span class="arrow"> → </span>

            <div class="rate" label="target">
                <select name="target" id="target" required>
                    <%for (const key in conversionRates) {
                        if (conversionRates.hasOwnProperty(key)) {%>
                        <option value="<%=key%>"><%= key %></option>
                        <%}
                    }%>
                </select>
            </div>
        </div>
        <div class="submit">
            <input type="submit" value="Submit">
        </div>
        </form>
    <%}%>

    <%if (locals.baseCode) {%>
        <h2><%=baseCode + " → " + targetCode%></h2>
        <span>Starting Amount: <%=baseAmount%></span>
        <span>Amount in <%=targetCode%>: <%=Math.round(baseAmount * conversionRate * 100) / 100%></span>
        <a href="/"><button class="start-over">Start Over</button></a>
    <%}%>

    <%if (locals.error) {%>
        <span>The base currency amount must be a number.</span>
        <a href="/"><button class="start-over">Start Over</button></a>
    <%}%>
</body>
</html>